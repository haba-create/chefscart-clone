# ==============================================
# Frontend Environment Variables
# ==============================================

# Anthropic API Key for AI Shopping Assistant
# Get your API key from: https://console.anthropic.com/
VITE_ANTHROPIC_API_KEY=sk-ant-your-api-key-here

# Backend API URL (default: http://localhost:3001)
VITE_API_URL=http://localhost:3001

# ==============================================
# Backend Environment Variables
# ==============================================

# Apify Configuration (REQUIRED for real supermarket data)
# Sign up at https://apify.com and get your API token
# Provides real product data from Tesco, Sainsbury's, and Waitrose
APIFY_API_TOKEN=your_apify_api_token_here

# Server Configuration
PORT=3001
NODE_ENV=production

# Database Configuration
DATABASE_PATH=./database/products.db

# Scraping Configuration
CACHE_EXPIRY_HOURS=6
RATE_LIMIT_PER_MINUTE=60
ENABLE_CACHING=true

# ==============================================
# Notes
# ==============================================
# - RAPID_API_KEY is optional but highly recommended
# - Without RapidAPI key, the app will attempt direct scraping (slower, less reliable)
# - Direct scraping respects robots.txt and implements rate limiting
# - UK ONS (Office for National Statistics) uses similar scraping for official price indices
